<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^alusiai\.com$ [NC]
  RewriteRule ^ https://alusiai.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:html?)$">
    Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
    Header always set CDN-Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(?:css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(?:avif|webp|png|jpe?g|svg|mp4|m4v)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>

  Header merge Vary "Accept-Encoding"
</IfModule>
